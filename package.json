{
  "name": "m3food-organic-bright-landing",
  "version": "1.6.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:bootstrap:m3food": "node --import tsx scripts/db-bootstrap.ts --config config/stores/m3food.json",
    "db:verify:m3food": "node --import tsx scripts/db-verify.ts --config config/stores/m3food.json",
    "db:verify:api": "node --import tsx scripts/db-verify-api.ts",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:batch-02": "node scripts/verify-batch-02.mjs",
    "verify:batch-03": "node scripts/verify-batch-03.mjs",
    "verify:batch-04": "node scripts/verify-batch-04.mjs",
    "test:domain": "node --import tsx --test src/lib/commerce/*.test.ts src/lib/config/*.test.ts src/lib/db/*.test.ts src/lib/http/*.test.ts",
    "check": "npm run verify:foundation && npm run verify:batch-02 && npm run verify:batch-03 && npm run verify:batch-04 && npm run test:domain && npm run typecheck && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "postgres": "3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
