# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Active storefront identity.
# Keep NEXT_PUBLIC_STORE_SLUG and DEFAULT_STORE_SLUG equal for a single-client deployment.
# For a new client, change both values to that client's lowercase kebab-case store slug.
NEXT_PUBLIC_STORE_SLUG=m3food
DEFAULT_STORE_SLUG=m3food

# Supabase PostgreSQL
# Runtime: use the transaction pooler URL (normally port 6543).
DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres

# Migrations/bootstrap: use the direct URL, or session pooler on IPv4 networks
# (normally port 5432). Never expose either value to browser-side code.
MIGRATION_DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres

# Random server-only secret (minimum 32 characters) used to HMAC rate-limit keys.
RATE_LIMIT_SALT=
# Optional dedicated stable HMAC secret for signed unsubscribe/preference links.
# If blank, RATE_LIMIT_SALT is used as a backward-compatible fallback.
MARKETING_PREFERENCE_SECRET=replace-with-a-cryptographically-random-secret

# Random server-only secret (minimum 32 characters) used to hash admin session
# tokens before they are persisted. Never expose this to browser-side code.
ADMIN_SESSION_SECRET=replace-with-another-cryptographically-random-secret

# Meta Conversions API (optional but required for server-side Meta delivery).
# Configure both together. Keep the access token server-only.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
# Optional while validating events in Meta Events Manager.
META_CAPI_TEST_EVENT_CODE=

# Paid Ads delivery sync (optional; server-only).
# Meta Ads reading is separate from CAPI event sending.
# Configure both Meta Ads values together or leave both blank.
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=

# Google Ads delivery sync (optional; server-only).
# Configure the five required values together or leave them blank.
# LOGIN_CUSTOMER_ID is optional for manager-account access.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Steadfast Courier (optional until the merchant account is connected).
# Keep both credentials server-only. The base URL can be overridden if Steadfast changes portals.
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
