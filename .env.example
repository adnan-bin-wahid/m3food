# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Neon
# Copy this file to .env.local and replace the value before running migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The first M3Food record will be inserted by a later seed batch.
# Business logic must resolve a store from data instead of hardcoding this value.
DEFAULT_STORE_SLUG=m3food
